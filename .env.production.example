# Production settings. Enter these in your host's environment settings
# (Vercel → Project → Settings → Environment Variables). Never commit real values.

# Pooled connection string from your Postgres provider (used by the app).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Direct (non-pooled) connection string, used only to apply migrations at build time.
MIGRATE_DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# 48+ random characters: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""
JWT_EXPIRES_IN="12h"

# Your public HTTPS address (no trailing slash).
APP_URL="https://exams.your-college.edu"

# Demo shortcuts must be off in production.
NEXT_PUBLIC_ENABLE_DEMO_LOGIN="false"
# Optional: organization slug pre-filled on the sign-in page.
NEXT_PUBLIC_DEFAULT_ORG_SLUG=""

# Email (required for "Forgot password" and seating notices).
SMTP_HOST="smtp.your-provider.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="SeatGuard <no-reply@your-college.edu>"

# SMS (optional).
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
SMS_DEFAULT_COUNTRY_CODE="+91"
