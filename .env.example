# Copy to `.env` and adjust. Both Next.js and Prisma read `.env`.

# PostgreSQL connection (matches docker-compose.yml)
DATABASE_URL="postgresql://exam_admin:exam_admin_password@localhost:5432/exam_seat_management?schema=public"

# JWT signing secret: at least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="replace-me-with-a-long-random-secret"
# Session lifetime (jose duration string, e.g. "12h", "7d")
JWT_EXPIRES_IN="7d"

# Organization slug prefilled on the login page
NEXT_PUBLIC_DEFAULT_ORG_SLUG="apex-institute"

# Show one-click demo sign-in buttons and the header role switcher.
# They log in through the real API using the seeded demo accounts.
# Set to "false" (or remove) in production.
NEXT_PUBLIC_ENABLE_DEMO_LOGIN="true"

# Public base URL, used in emailed links and the hall-ticket QR code.
APP_URL="http://localhost:3000"

# ── Email (optional) ──
# Without SMTP_HOST, emails are written to the notification outbox and the
# server log instead of being sent, and "Forgot password" shows the reset link
# on screen (development only).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="SeatGuard <no-reply@your-college.edu>"

# ── SMS via Twilio (optional) ──
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
# Prefix added to phone numbers stored without a country code.
SMS_DEFAULT_COUNTRY_CODE="+91"
